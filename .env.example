# Rhythm runs fully with NONE of these set. They only enable optional features.

# Optional: LLM day briefing (app/api/explain). Without it, a template is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional: raises MBTA V3 rate limits (app/api/conditions). Works without it.
MBTA_API_KEY=

# Optional: real email sending for heads-up notices (app/api/notify).
# Without it, Rhythm opens a pre-filled mailto: draft instead.
RESEND_API_KEY=
NOTIFY_FROM=Rhythm <onboarding@resend.dev>

# Optional: route ALL outgoing mail to this address (demo safety).
NOTIFY_OVERRIDE_TO=
